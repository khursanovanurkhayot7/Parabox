# Unity generated folders (machine-specific / rebuildable — never commit these)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
/[Dd]ata/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
/LocalBackups/
/Assets/_Recovery/

# Keep .meta files for assets that ARE committed
!/[Aa]ssets/**/*.meta
/Assets/_Recovery.meta

# IDE / editor project files (auto-generated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS and crash files
.DS_Store
Thumbs.db
mono_crash.*.json

# Build artifacts / packages
*.apk
*.aab
*.unitypackage
*.zip
*.app
ExportedObj/
crashlytics-build.properties
/LuxoddWebGLUpload-*/
/hayotsparabox*/
/parabox[0-9]*/
/parabox hayot/
/paraboxlsl/

# Bundle only the approved soundtrack and its license/readme records. Any other audio dropped
# into this folder stays local until its redistribution rights have been checked.
/[Aa]ssets/Parabox/Audio/*
!/[Aa]ssets/Parabox/Audio/Flowerbed Fields - Zane Little Music.ogg
!/[Aa]ssets/Parabox/Audio/Flowerbed Fields - Zane Little Music.ogg.meta
!/[Aa]ssets/Parabox/Audio/FUN_AUDIO_README.txt
!/[Aa]ssets/Parabox/Audio/FUN_AUDIO_README.txt.meta
!/[Aa]ssets/Parabox/Audio/MUSIC_LICENSE.txt
!/[Aa]ssets/Parabox/Audio/MUSIC_LICENSE.txt.meta
