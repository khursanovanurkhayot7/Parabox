# Unity generated folders (machine-specific / rebuildable — never commit these)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Keep .meta files for assets that ARE committed
!/[Aa]ssets/**/*.meta

# IDE / editor project files (auto-generated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db

# Build artifacts / packages
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties
