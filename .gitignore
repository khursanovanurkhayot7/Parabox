# Unity generated folders (machine-specific / rebuildable — never commit these)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
/[Dd]ata/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Keep .meta files for assets that ARE committed
!/[Aa]ssets/**/*.meta

# IDE / editor project files (auto-generated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db

# Build artifacts / packages
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties

# Bundle only the verified CC0 soundtrack and its license record. Any other audio dropped into
# this folder stays local until its redistribution rights have been checked.
/[Aa]ssets/Parabox/Audio/*
!/[Aa]ssets/Parabox/Audio/Sci-Fi Puzzle In-Game 1 - MintoDog.ogg
!/[Aa]ssets/Parabox/Audio/Sci-Fi Puzzle In-Game 1 - MintoDog.ogg.meta
!/[Aa]ssets/Parabox/Audio/MUSIC_LICENSE.txt
!/[Aa]ssets/Parabox/Audio/MUSIC_LICENSE.txt.meta
